# ============================================================================
# Orbit — 環境變數範本
# 複製為 .env 後填入。VITE_ 開頭會打包進前端（公開）；
# 沒有 VITE_ 前綴的只有後端 server/ 讀得到（機密）。
# ============================================================================

# ---------- 前端 ----------
# 本地開發用相對路徑，由 Vite dev proxy 轉發到 API server。
VITE_API_BASE_URL=/api/v1
VITE_BASE_PATH=/
VITE_APP_MODE=development

# 平台層級追蹤碼（選填，各商家自己的 GA/Pixel 在後台設定，不放這裡）
VITE_GTM_ID=
VITE_HOTJAR_ID=
VITE_FB_PIXEL_ID=

VITE_MARKETING_HOST=https://booking.homo.tw
VITE_SUPPORT_LINE_URL=https://line.me/R/ti/p/@209agtiq
VITE_SUPPORT_EMAIL=vicky.chou@homo.tw

# ---------- 後端 (server/) ----------
# Supabase 專案：Dashboard → Project Settings → API
SUPABASE_URL=https://ourhzenuvampgmdkysrn.supabase.co

# ⚠️ service_role 是「完全權限」金鑰，會繞過 RLS。
#    只放在後端、絕不要加 VITE_ 前綴、絕不要 commit 進版控。
#    取得位置：Dashboard → Project Settings → API → service_role (Reveal)
SUPABASE_SERVICE_ROLE_KEY=

# API server 埠號，以及對外可達的網址（用來組 LINE webhook URL）
API_PORT=8080
PUBLIC_API_URL=http://localhost:8080
# 簽發 / 驗證登入 token 用的密鑰。請自行產生：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
