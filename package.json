{
  "name": "orbit-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Orbit 預約系統 — 後台管理骨架 (self-hostable, multi-tenant reconstruction)",
  "engines": {
    "comment": "@supabase/supabase-js 的 realtime client 需要原生 WebSocket；Node 20 下 createClient() 會拋錯",
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n api,web -c magenta,cyan \"npm:api\" \"npm:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node server/index.js",
    "db:check": "node server/check.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:local": "SMOKE_BASE_URL=http://localhost:8080/api/v1 node scripts/smoke.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "@supabase/supabase-js": "^2.112.3",
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}